{
  "openapi": "3.0.0",
  "info": {
    "title": "Witching & Wonder API",
    "version": "1.0.0",
    "description": "Halloween-inspired storefront API with item browsing, filtering, and MongoDB-backed CRUD for Witching & Wonder."
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "summary": "Homepage",
        "responses": {
          "200": {
            "description": "Serves the homepage HTML"
          }
        }
      }
    },
    "/api/items": {
      "get": {
        "summary": "Get all items with optional filtering and sorting",
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Filter items by category"
          },
          {
            "name": "name",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Search by item name"
          },
          {
            "name": "minPrice",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number"
            },
            "description": "Minimum price"
          },
          {
            "name": "maxPrice",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number"
            },
            "description": "Maximum price"
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["name", "category", "price"]
            },
            "description": "Sort field"
          },
          {
            "name": "order",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["asc", "desc"]
            },
            "description": "Sort direction"
          }
        ],
        "responses": {
          "200": {
            "description": "Returns all items",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "count": {
                      "type": "integer"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Item"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a new item",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ItemInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Item created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Item"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request body"
          }
        }
      }
    },
    "/api/items/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "example": "507f1f77bcf86cd799439011"
          },
          "description": "MongoDB ObjectId of the item"
        }
      ],
      "get": {
        "summary": "Get one item by MongoDB ObjectId",
        "responses": {
          "200": {
            "description": "Item found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Item"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid MongoDB ObjectId"
          },
          "404": {
            "description": "Item not found"
          }
        }
      },
      "patch": {
        "summary": "Update an item by MongoDB ObjectId",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ItemInputPartial"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Item updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Item"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid ObjectId or invalid payload"
          },
          "404": {
            "description": "Item not found"
          }
        }
      },
      "delete": {
        "summary": "Delete an item by MongoDB ObjectId",
        "responses": {
          "204": {
            "description": "Item deleted successfully"
          },
          "400": {
            "description": "Invalid MongoDB ObjectId"
          },
          "404": {
            "description": "Item not found"
          }
        }
      }
    },
    "/does-not-exist": {
      "get": {
        "summary": "Invalid route test",
        "responses": {
          "404": {
            "description": "Route not found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Item": {
        "type": "object",
        "required": [
          "_id",
          "name",
          "category",
          "price"
        ],
        "properties": {
          "_id": {
            "type": "string",
            "example": "507f1f77bcf86cd799439011"
          },
          "name": {
            "type": "string",
            "example": "Moonlit Candle"
          },
          "category": {
            "type": "string",
            "example": "Rituals"
          },
          "price": {
            "type": "number",
            "example": 16.5
          }
        }
      },
      "ItemInput": {
        "type": "object",
        "required": [
          "name",
          "category",
          "price"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "Moonstone Charm"
          },
          "category": {
            "type": "string",
            "example": "Jewelry"
          },
          "price": {
            "type": "number",
            "example": 28.0
          }
        }
      },
      "ItemInputPartial": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Moonstone Charm"
          },
          "category": {
            "type": "string",
            "example": "Jewelry"
          },
          "price": {
            "type": "number",
            "example": 28.0
          }
        }
      }
    }
  }
}
